<resources xmlns:android="http://schemas.android.com/apk/res/android">
    <style name="Base.Theme.MRKLab" parent="Theme.AppCompat.NoActionBar">
        <item name="android:textAppearance">@id/normal</item>
        <item name="actionBarSize">?android:actionBarSize</item>
        <item name="actionOverflowMenuStyle">@style/OverflowMenu</item>
        <item name="android:textAppearanceSmallPopupMenu">@style/OverflowMenu</item>
    </style>

    <style name="Theme.MRKLab" parent="Base.Theme.MRKLab">
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@color/white</item>
    </style>

    <style name="Toolbar.MRKLab" parent="Base.Theme.MRKLab">
        <item name="android:textSize">14sp</item>
        <item name="android:background">@color/splash</item>
        <item name="android:textColor">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
    </style>

<style name="OverflowMenu" parent= "ThemeOverlay.AppCompat.Light">
        <item name="android:overlapAnchor">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:popupBackground">@color/darker</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:background">@color/white</item>
        <item name="android:textColor">@color/splash</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:colorBackground">@color/darker</item>
    </style>

    <style name="ToolbarTitleStyle" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="PopupMenuTextAppearance" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColor">@color/white</item>
        <item name="android:colorBackground">@color/darker</item>
    </style>
</resources>